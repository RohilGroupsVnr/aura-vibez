rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Products: everyone can browse, only admins can change
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: a customer can create/update ONLY their own doc and can never make themselves admin
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.role == resource.data.role) || isAdmin());
    }

    // Orders: customers create + read their own; can cancel only while "Placed"; admins manage all
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'Placed';
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid && resource.data.status == 'Placed'
          && request.resource.data.status == 'Cancelled') || isAdmin());
    }

    // Newsletter: anyone can subscribe, only admins can read
    match /subscribers/{id} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }
  }
}
